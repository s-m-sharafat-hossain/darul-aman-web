// ---------------------------------------------------------------------------

model Certificate {
  id                 String   @id @default(uuid())
  studentId          String   @map("student_id")
  certificateType    String   @map("certificate_type")
  certificateNumber  String   @unique @map("certificate_number")
  relatedExamId      String?  @map("related_exam_id")
  fileUrl            String?  @map("file_url")
  issuedBy           String?  @map("issued_by")
  issuedAt           DateTime @default(now()) @map("issued_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("certificates")
}

// ---------------------------------------------------------------------------
// NOTICES & NOTIFICATIONS
// ---------------------------------------------------------------------------

// Public-website Gallery (CMS-managed). A dedicated model rather than
// reusing FileAsset above: FileAsset is a generic, currently-unused
// polymorphic attachment table with no publish workflow, category, or
// ordering — bolting gallery-specific CMS fields onto it would make it
// neither a clean generic file table nor a clean gallery model. GalleryItem
// follows the same direct-URL-field convention already used elsewhere
// (Notice.attachmentUrl, Staff.photoUrl) instead of indirecting through
// FileAsset.
model GalleryItem {
  id          String    @id @default(uuid())
  title       String
  description String?
  imageUrl    String    @map("image_url")
  category    String    @default("other")
  eventDate   DateTime? @map("event_date")
  isPublished Boolean   @default(false) @map("is_published")
  isFeatured  Boolean   @default(false) @map("is_featured")
  sortOrder   Int       @default(0) @map("sort_order")
  createdBy   String    @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Covers the public gallery/homepage query shape: published items,
  // optionally filtered by category, newest first.
  @@index([isPublished, category, createdAt])
  // Covers "Recent Photos" home page query: published + featured, newest first.
  @@index([isPublished, isFeatured, createdAt])
  @@map("gallery_items")
}

model Notice {
  id            String    @id @default(uuid())
  title         String
  body          String
  attachmentUrl String?   @map("attachment_url")
  audience      String    @default("all")
  classId       Int?      @map("class_id")
  departmentId  Int?      @map("department_id")
  publishedBy   String    @map("published_by")
  publishedAt   DateTime? @map("published_at")
  isPublished   Boolean   @default(false) @map("is_published")
  createdAt     DateTime  @default(now()) @map("created_at")

  class      Class?      @relation(fields: [classId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([classId])
  @@index([departmentId])
  @@index([isPublished, audience, publishedAt])
  @@map("notices")
}

model Notification {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  type               String
  title              String
  body               String?
  relatedEntityType  String?   @map("related_entity_type")
  relatedEntityId    String?   @map("related_entity_id")
  isRead             Boolean   @default(false) @map("is_read")
  readAt             DateTime? @map("read_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// SECURITY & AUDIT
// ---------------------------------------------------------------------------

model AuditLog {
  id          Int   @id @default(autoincrement())
  userId      String?  @map("user_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  beforeData  String?    @map("before_data")
  afterData   String?    @map("after_data")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ApprovalRequest {
  id           String    @id @default(uuid())
  requestType  String    @map("request_type")
  entityType   String    @map("entity_type")
  entityId     String    @map("entity_id")
  payload      String?
  requestedBy  String    @map("requested_by")
  status       String    @default("pending")
  reviewedBy   String?   @map("reviewed_by")
  reviewNote   String?   @map("review_note")
  createdAt    DateTime  @default(now()) @map("created_at")
  reviewedAt   DateTime? @map("reviewed_at")

  @@map("approval_requests")
}

model FailedLoginAttempt {
  id          Int   @id @default(autoincrement())
  identifier  String
  ipAddress   String?  @map("ip_address")
  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@index([identifier, attemptedAt])
  @@map("failed_login_attempts")
}

model FileAsset {
  id                  String   @id @default(uuid())
  ownerUserId         String?  @map("owner_user_id")
  fileName            String   @map("file_name")
  filePath            String   @map("file_path")
  mimeType            String   @map("mime_type")
  fileSizeBytes       BigInt   @map("file_size_bytes")
  visibility          String   @default("private")
  relatedEntityType   String?  @map("related_entity_type")
  relatedEntityId     String?  @map("related_entity_id")
  uploadedAt          DateTime @default(now()) @map("uploaded_at")

  @@map("files")
}
