# ============================================================================
# Darul Aman Academy Portal — Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env itself.
# ============================================================================

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/daa_portal?schema=public"

# JWT secrets — generate strong random values, e.g. `openssl rand -hex 64`
# Never reuse the same secret for both.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (the existing public
# website's domain + the portal's own domain, if served separately)
CORS_ORIGIN="https://darulamanacademy.example,http://localhost:3000"

# File uploads
UPLOAD_DIR=uploads

# Public URL of the website/portal frontend — used to build links inside
# transactional emails (e.g. the password reset link). No trailing slash.
FRONTEND_URL="https://darulamanacademy.example"

# SMTP — powers password-reset emails (see src/utils/mailer.js). Works with
# any SMTP account: school Gmail Workspace, Outlook 365, cPanel hosting
# mail, or an SMTP relay from SendGrid/Mailgun/etc. If left unset, reset
# emails are skipped (logged as a warning) rather than causing an error —
# safe for local dev, but must be set before relying on this in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Darul Aman Academy <no-reply@darulamanacademy.example>"

# Future integrations (SMS / Push) — wire these in when providers are
# chosen; notification_deliveries table already supports the fan-out.
SMS_PROVIDER_API_KEY=
PUSH_PROVIDER_API_KEY=

# Online payment gateway (structured for, not yet wired — spec §9)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=
